// Prisma Schema for ChessInReact (Spec 09 § 4, § 6, RF-01, RF-06, RF-08, RF-12)
// Configured for Supabase PostgreSQL with Row Level Security (RLS) support

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  email         String?         @unique
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Multidimensional Glicko-2 ratings map keyed by variantId (Spec 09 § 6)
  // Example: { "standard": { "rating": 1500, "rd": 350, "vol": 0.06 }, "duck": { ... } }
  ratingsMap    Json            @default("{}")

  createdVariants CustomVariant[]
  ratings         PlayerRating[]

  @@index([username])
}

model PlayerRating {
  id              String   @id @default(uuid())
  userId          String
  variantId       String
  ratingValue     Float    @default(1500.0)
  ratingDeviation Float    @default(350.0)
  volatility      Float    @default(0.06)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Compound B-Tree Index for Leaderboard queries < 30ms (Spec 09 § 6, RF-12)
  @@unique([userId, variantId])
  @@index([variantId, ratingValue(sort: Desc)])
}

model MatchHistory {
  id            String       @id // Unique match ID generated by Matchmaker
  endedAt       DateTime     @default(now())
  variantId     String
  engineVersion String       @default("1.0.0") // Rules engine semantic version (RF-10)
  isRanked      Boolean      @default(true)

  // Open Tag Roster metadata JSON (Topology, Seed, TimeControl, etc.)
  metadata      Json

  // Ordered player UUIDs and corresponding outcomes
  playerIds     String[]
  playerResults String[]

  // Compact linear event stream / PGN tape
  moveStream    String[]

  // Optional compressed byte payload for matches > 50 moves (RF-03)
  compressedPayload Bytes?

  events        MatchEvent[]

  @@index([variantId])
  @@index([endedAt(sort: Desc)])
}

model MatchEvent {
  id            String       @id @default(uuid())
  matchId       String
  ply           Int
  notation      String       // UCI or SAN notation e.g. "e2e4"
  fromCoord     String
  toCoord       String
  pieceId       String
  capturedPiece String?
  timestampMs   Int          // Milliseconds from game start
  
  match         MatchHistory @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, ply])
}

model CustomVariant {
  id            String    @id @default(uuid())
  authorId      String
  name          String
  betzaRules    String    // Betza notation parsed by Spec 04 / Spec 10
  visualMeshUrl String?   // Custom GLTF asset URL
  isPublic      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? // Soft-delete to preserve historic replay compatibility (RF-09)

  author        User      @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([isPublic, deletedAt])
}
