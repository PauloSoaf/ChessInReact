{
  "name": "chessinreact",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "node --loader ts-node/esm or vitest",
    "bench:memory": "node --expose-gc scripts/runMemoryBenchmark.js",
    "bench:perft": "node --expose-gc scripts/runPerftBenchmark.js",
    "bench:soak": "node --expose-gc scripts/runSoakTest60Min.js"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.37",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "antd": "^5.17.3",
    "colyseus": "^0.15.57",
    "colyseus.js": "^0.15.28",
    "immer": "^10.2.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.186.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
